{
  "name": "@functional-systems/memdrive",
  "version": "0.1.0",
  "description": "Source-linked memory storage and retrieval backed by LambdaDB.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE",
    "docs/tools.md"
  ],
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./types": "./src/types.ts",
      "./package.json": "./package.json",
      "./tools": "./src/tools/index.ts"
    }
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 src",
    "typecheck": "tsc --noEmit",
    "build": "tshy",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "check:version": "node scripts/version.mjs get",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs",
    "test:live": "npm run build && MEMDRIVE_RUN_LIVE_TESTS=1 node --env-file-if-exists=.env.local --test --test-concurrency=1 test/integration/*-live.test.mjs"
  },
  "dependencies": {
    "@functional-systems/lambdadb": "0.12.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "ajv": "8.20.0",
    "esbuild": "0.28.2",
    "eslint": "9.32.0",
    "globals": "15.15.0",
    "tshy": "2.0.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/esm/types.d.ts",
        "default": "./dist/esm/types.js"
      },
      "require": {
        "types": "./dist/commonjs/types.d.ts",
        "default": "./dist/commonjs/types.js"
      }
    },
    "./package.json": "./package.json",
    "./tools": {
      "import": {
        "types": "./dist/esm/tools/index.d.ts",
        "default": "./dist/esm/tools/index.js"
      },
      "require": {
        "types": "./dist/commonjs/tools/index.d.ts",
        "default": "./dist/commonjs/tools/index.js"
      }
    }
  },
  "author": "Functional Systems, Inc.",
  "homepage": "https://github.com/lambdadb/memdrive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdadb/memdrive.git"
  },
  "bugs": {
    "url": "https://github.com/lambdadb/memdrive/issues"
  },
  "publishConfig": {
    "access": "public",
    "tag": "dev"
  }
}
