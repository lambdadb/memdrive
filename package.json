{
  "name": "@functional-systems/memdrive",
  "version": "0.1.0",
  "description": "Branch-scoped file storage backed by LambdaDB.",
  "type": "module",
  "engines": {
    "node": ">=20.12"
  },
  "sideEffects": false,
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "NOTICE"
  ],
  "main": "./dist/commonjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/commonjs/index.d.ts",
  "tshy": {
    "exports": {
      ".": "./src/index.ts",
      "./package.json": "./package.json",
      "./docling": "./src/docling.ts"
    }
  },
  "scripts": {
    "lint": "eslint --max-warnings=0 src benchmark",
    "typecheck": "tsc --noEmit",
    "build": "tshy",
    "test": "npm run build && npm run test:types && node --test test/*.test.mjs",
    "test:types": "tsc -p test/types/tsconfig.json",
    "check:version": "node scripts/version.mjs get",
    "check:package": "npm run build && node scripts/check-package.mjs",
    "prepublishOnly": "node scripts/check-publish.mjs",
    "test:live": "npm run build && MEMDRIVE_RUN_LIVE_TESTS=1 node --env-file-if-exists=.env.local --test --test-concurrency=1 test/integration/*-live.test.mjs",
    "benchmark:longmemeval": "npm run build && node benchmark/longmemeval/run.mjs",
    "benchmark:tools": "npm run build && node benchmark/tool-use/run.mjs",
    "benchmark:beam-replay": "npm run build && node benchmark/beam/replay.mjs"
  },
  "dependencies": {
    "@functional-systems/lambdadb": "0.14.0"
  },
  "devDependencies": {
    "@eslint/js": "9.32.0",
    "@types/node": "24.10.0",
    "ajv": "8.20.0",
    "docling.rs": "2.85.0",
    "esbuild": "0.28.2",
    "eslint": "9.32.0",
    "globals": "15.15.0",
    "tiktoken": "1.0.22",
    "tshy": "2.0.1",
    "typescript": "5.8.3",
    "typescript-eslint": "8.38.0"
  },
  "license": "Apache-2.0",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/commonjs/index.d.ts",
        "default": "./dist/commonjs/index.js"
      }
    },
    "./package.json": "./package.json",
    "./docling": {
      "import": {
        "types": "./dist/esm/docling.d.ts",
        "default": "./dist/esm/docling.js"
      },
      "require": {
        "types": "./dist/commonjs/docling.d.ts",
        "default": "./dist/commonjs/docling.js"
      }
    }
  },
  "author": "Functional Systems, Inc.",
  "homepage": "https://github.com/lambdadb/memdrive#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lambdadb/memdrive.git"
  },
  "bugs": {
    "url": "https://github.com/lambdadb/memdrive/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "docling.rs": "2.85.0"
  },
  "peerDependenciesMeta": {
    "docling.rs": {
      "optional": true
    }
  }
}
